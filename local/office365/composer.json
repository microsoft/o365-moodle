    "keywords": [
        "moodle",
        "microsoft-365",
        "office365"
    ],
    "homepage": "https://github.com/microsoft/o365-moodle",
    "license": "GPL-3.0-or-later",
    "support": {
        "issues": "https://github.com/microsoft/o365-moodle/issues",
