        "microsoft/moodle-auth_oidc": "^5.1.3",
        "microsoft/moodle-block_microsoft": "^5.1.3",
        "microsoft/moodle-local_o365": "^5.1.3",
        "microsoft/moodle-repository_office365": "^5.1.2",
